# ============================================================
# Review Data Import
# ============================================================
# The order reviews CSV contained multiline text and special
# characters that caused issues during the standard database
# import process.
#
# Pandas was used to read the CSV into a DataFrame, and
# SQLAlchemy was used to load the data directly into PostgreSQL.
# ============================================================


import pandas as pd

from sqlalchemy import create_engine, text
from sqlalchemy.engine import URL


# ------------------------------------------------------------
# 1. Load the reviews CSV
# ------------------------------------------------------------
# The Python parsing engine was used to handle the text-heavy
# review dataset more reliably.

reviews_path = "path/to/olist_order_reviews_dataset.csv"

df_reviews = pd.read_csv(
    reviews_path,
    encoding="utf-8",
    engine="python",
    dtype=str
)


# Basic validation of the imported DataFrame
print("DataFrame shape:", df_reviews.shape)
print("Columns:", df_reviews.columns.tolist())



# ------------------------------------------------------------
# 2. Create the PostgreSQL connection
# ------------------------------------------------------------
# Credentials should never be committed to a public repository.
# Replace the placeholders locally before running the notebook.

database_url = URL.create(
    drivername="postgresql+psycopg",
    username="YOUR_USERNAME",
    password="YOUR_PASSWORD",
    host="localhost",
    port=5432,
    database="olist"
)

engine = create_engine(database_url)



# ------------------------------------------------------------
# 3. Test the database connection
# ------------------------------------------------------------

with engine.connect() as connection:
    result = connection.execute(
        text("SELECT current_database(), current_user")
    )
    print("Connected to:", result.fetchone())



# ------------------------------------------------------------
# 4. Load the reviews DataFrame into PostgreSQL
# ------------------------------------------------------------
# The table is written in chunks to make the import more
# manageable for larger datasets.

df_reviews.to_sql(
    name="olist_order_reviews_dataset",
    con=engine,
    schema="public",
    if_exists="replace",
    index=False,
    chunksize=1000
)

print("Imported review rows:", len(df_reviews))



# ------------------------------------------------------------
# 5. Validate the PostgreSQL import
# ------------------------------------------------------------
# Confirm that the number of rows written to PostgreSQL matches
# the DataFrame row count.

with engine.connect() as connection:
    result = connection.execute(
        text("""
            SELECT COUNT(*)
            FROM public.olist_order_reviews_dataset
        """)
    )

    postgres_rows = result.scalar()

print("Rows in DataFrame:", len(df_reviews))
print("Rows in PostgreSQL:", postgres_rows)
